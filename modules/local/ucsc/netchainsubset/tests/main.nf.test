nextflow_process {

    name "Test Process UCSC_NETCHAINSUBSET"
    script "../main.nf"
    process "UCSC_NETCHAINSUBSET"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "ucsc"
    tag "ucsc/netchainsubset"

    // Fixtures: tests/data/yeast_small (made with the v1.0.0 CNEr command lines).
    // small.subset.chain is the intermediate of the small.over.chain recipe:
    //   netChainSubset -verbose=0 small.noClass.net small.all.chain small.subset.chain
    //   (chainStitchId small.subset.chain stdout reproduces small.over.chain)
    // projectDir resolves to the repository root (the nf-test.config directory),
    // both inside the Nextflow process block and in the nf-test then block.
    //
    // The chain, net and axt inputs and references depend on the platform (axtChain orders chains of equal score
    // differently on macOS and Linux): they are in tests/data/yeast_small/platform/<platform>/
    // (tests/lib/PlatformReferences.groovy), and the snapshots only hold the output names and versions.

    test("yeast_small - net, chain") {

        when {
            def fixtures = PlatformReferences.dir(projectDir, 'yeast_small')
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${fixtures}/small.noClass.net", checkIfExists: true),
                    file("${fixtures}/small.all.chain", checkIfExists: true)
                ]
                """
            }
        }

        then {
            // parity: decompressed output must be byte-identical to the netChainSubset step of small.over.chain
            def gunzipMd5 = { f -> new java.util.zip.GZIPInputStream(new FileInputStream(f.toString())).withCloseable { it.bytes.md5() } }
            def ref_md5 = path(PlatformReferences.file(projectDir, 'yeast_small', 'small.subset.chain')).bytes.md5()
            assertAll(
                { assert process.success },
                { assert snapshot(
                    PlatformReferences.fileNames(process.out.chain),
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert gunzipMd5(process.out.chain[0][1]) == ref_md5 }
            )
        }
    }

    test("yeast_small - net, chain - stub") {

        options "-stub"

        when {
            def fixtures = PlatformReferences.dir(projectDir, 'yeast_small')
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${fixtures}/small.noClass.net", checkIfExists: true),
                    file("${fixtures}/small.all.chain", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
