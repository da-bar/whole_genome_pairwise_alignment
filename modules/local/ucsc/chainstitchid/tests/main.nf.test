nextflow_process {

    name "Test Process UCSC_CHAINSTITCHID"
    script "../main.nf"
    process "UCSC_CHAINSTITCHID"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "ucsc"
    tag "ucsc/chainstitchid"
    tag "ucsc/netchainsubset"

    // Fixtures: tests/data/yeast_small. small.over.chain was made with
    //   netChainSubset -verbose=0 small.noClass.net small.all.chain stdout | chainStitchId stdin small.over.chain
    // projectDir resolves to the repository root (the nf-test.config directory),
    // both inside the Nextflow process block and in the nf-test then block.

    test("yeast_small - chain.gz from UCSC_NETCHAINSUBSET") {

        setup {
            run("UCSC_NETCHAINSUBSET") {
                script "../../netchainsubset/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ], // meta map
                        file("${projectDir}/tests/data/yeast_small/small.noClass.net", checkIfExists: true),
                        file("${projectDir}/tests/data/yeast_small/small.all.chain", checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = UCSC_NETCHAINSUBSET.out.chain
                """
            }
        }

        then {
            // parity: netChainSubset + chainStitchId must reproduce small.over.chain byte for byte
            def gunzipMd5 = { f -> new java.util.zip.GZIPInputStream(new FileInputStream(f.toString())).withCloseable { it.bytes.md5() } }
            def ref_md5 = path("${projectDir}/tests/data/yeast_small/small.over.chain").bytes.md5()
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert gunzipMd5(process.out.chain[0][1]) == ref_md5 }
            )
        }
    }

    test("yeast_small - chain - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${projectDir}/tests/data/yeast_small/small.all.chain", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
