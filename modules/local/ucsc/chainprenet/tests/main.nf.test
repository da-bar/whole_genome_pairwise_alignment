nextflow_process {

    name "Test Process UCSC_CHAINPRENET"
    script "../main.nf"
    process "UCSC_CHAINPRENET"
    tag "modules"
    tag "modules_local"
    tag "ucsc"
    tag "ucsc/chainprenet"

    // Fixtures live in <repo>/tests/data/yeast_small. In nf-test, "${projectDir}" inside the
    // test file resolves to the directory holding nf-test.config (the repository root).

    test("yeast_small - all.chain") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file("${projectDir}/tests/data/yeast_small/small.all.chain", checkIfExists: true),
                    file("${projectDir}/tests/data/yeast_small/scer_small.sizes", checkIfExists: true),
                    file("${projectDir}/tests/data/yeast_small/seub_small.sizes", checkIfExists: true)
                ])
                """
            }
        }

        then {
            // Parity with v1 (CNEr): md5 of the decompressed output must equal the v1-made fixture
            def gunzip_md5 = { f -> new java.util.zip.GZIPInputStream(new FileInputStream(f.toString())).withCloseable { it.bytes.md5() } }
            def out_md5 = gunzip_md5(process.out.chain[0][1])
            def v1_md5  = new File("${projectDir}/tests/data/yeast_small/small.all.pre.chain").bytes.md5()
            assertAll(
                { assert process.success },
                { assert out_md5 == v1_md5 },
                { assert snapshot(
                    process.out.chain,
                    out_md5,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("yeast_small - all.chain - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file("${projectDir}/tests/data/yeast_small/small.all.chain", checkIfExists: true),
                    file("${projectDir}/tests/data/yeast_small/scer_small.sizes", checkIfExists: true),
                    file("${projectDir}/tests/data/yeast_small/seub_small.sizes", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
