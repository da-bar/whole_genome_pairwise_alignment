    given-names: "Damir"
    affiliation: "Ruđer Bošković Institute"
  - family-names: "Kajan"
    given-names: "Katarina"
version: "1.0.0"
date-released: "2026-09-25"
license: MIT
repository-code: "https://github.com/da-bar/whole_genome_pairwise_alignment"
keywords:
  - whole-genome alignment
  - LAST
  - axtChain
  - chainNet
  - Nextflow
