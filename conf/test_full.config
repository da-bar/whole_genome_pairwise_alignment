/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The yeast pair with every preset, plus the reverse pair (S. eubayanus as target, with
    the default --preset). Each genome is used as target and as query, so this also tests
    that the 2bit/sizes files and the LAST indexes are made once per genome.

    Use as follows:
        nextflow run da-bar/wgpa -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Yeast pair with the near, medium and far presets, and the reverse pair'

    // Input data for full size test
    input  = "${projectDir}/assets/samplesheet_test_full.csv"
    preset = 'near'
}
