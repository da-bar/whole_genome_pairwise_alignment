/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    The selectors name the subworkflow ('.*:CHAIN_NET:UCSC_AXTCHAIN') so that they apply to
    pipeline runs only and not to the module tests, which set their own options.

    Pair meta map: [ id, preset, target_name, query_name ]. Output file stems follow v1.0.0:
    <target_name>_<query_name>.{maf,psl,chain,all.chain,all.pre.chain,noClass.net,net.axt}, gzipped.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Genome preparation: one <name>.2bit and <name>.sizes per distinct FASTA
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:PREPARE_GENOMES:UCSC_FATOTWOBIT|.*:PREPARE_GENOMES:UCSC_TWOBITINFO' {
        publishDir = [
            path: { "${params.outdir}/genomes" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Alignment (CNEr presets): <outdir>/<id>/alignment/
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:PAIRWISE_ALIGN:LAST_LASTDB' {
        // Set per preset in subworkflows/local/pairwise_align (lastdbArgs): '-c' for all CNEr presets
        ext.args   = { meta.lastdb_args }
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }

    withName: '.*:PAIRWISE_ALIGN:LAST_LASTAL' {
        // The scoring matrix (-p) is the preset's assets/matrices/<preset>.lastal.mat
        ext.args   = { [
            near   : '-a 600 -b 150 -e 3000 -s 2 -f 1',
            medium : '-a 400 -b 30 -e 4500 -s 2 -f 1',
            far    : '-a 400 -b 30 -e 6000 -s 2 -f 1',
        ][meta.preset] }
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.{maf.gz,tsv}'
        ]
    }

    withName: '.*:PAIRWISE_ALIGN:LAST_MAFCONVERT' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.psl.gz'
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Chains and nets: <outdir>/<id>/{chains,nets,axt}/
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:CHAIN_NET:UCSC_AXTCHAIN' {
        // The score scheme (-scoreScheme) is the preset's assets/matrices/<preset>.axtchain.mat
        ext.args   = { [
            near   : '-minScore=5000 -linearGap=medium',
            medium : '-minScore=3000 -linearGap=medium',
            far    : '-minScore=5000 -linearGap=loose',
        ][meta.preset] }
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/chains" },
            mode: params.publish_dir_mode,
            pattern: '*.chain.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_CHAINMERGESORT' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.all" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/chains" },
            mode: params.publish_dir_mode,
            pattern: '*.chain.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_CHAINPRENET' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.all.pre" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/chains" },
            mode: params.publish_dir_mode,
            pattern: '*.chain.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_CHAINNET' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/nets" },
            mode: params.publish_dir_mode,
            pattern: '*.net.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_NETSYNTENIC' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.noClass" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/nets" },
            mode: params.publish_dir_mode,
            pattern: '*.net.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_NETTOAXT' {
        // Intermediate: unsorted net alignments, sorted by UCSC_AXTSORT
        ext.prefix = { "${meta.target_name}_${meta.query_name}.unsorted" }
        publishDir = [ enabled: false ]
    }

    withName: '.*:CHAIN_NET:UCSC_AXTSORT' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.net" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/axt" },
            mode: params.publish_dir_mode,
            pattern: '*.axt.gz'
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        liftOver chains (UCSC naming): <outdir>/<id>/liftover/<target>To<Query>.over.chain.gz
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:LIFTOVER_CHAINS:UCSC_NETCHAINSUBSET' {
        // Intermediate: chains of the syntenic net, before chainStitchId
        ext.args   = '-verbose=0'
        ext.prefix = { "${meta.target_name}_${meta.query_name}.subset" }
        publishDir = [ enabled: false ]
    }

    withName: '.*:LIFTOVER_CHAINS:UCSC_CHAINSTITCHID' {
        ext.prefix = { "${meta.target_name}To${meta.query_name.capitalize()}.over" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/liftover" },
            mode: params.publish_dir_mode,
            pattern: '*.over.chain.gz'
        ]
    }
}
