/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The v1.0.0 test pair: S. cerevisiae (target) and S. eubayanus (query), preset near.
    The FASTA files are the ones in the v1.0.0 code commit (0280044), downloaded from GitHub;
    the same files are in tests/data/yeast/. The outputs match tests/data/yeast/v1.0.0_md5.txt.

    Use as follows:
        nextflow run da-bar/wgpa -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'S. cerevisiae vs S. eubayanus (v1.0.0 test pair), preset near'

    // Input data
    input  = "${projectDir}/assets/samplesheet_test.csv"
    preset = 'near'
}
