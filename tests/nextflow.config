/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/wgpa/'

    // Module tests do not set --outdir: publish into the test's own launch directory rather than 'null/'.
    // Pipeline tests set outdir in their params block, which takes precedence.
    outdir = 'results'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
